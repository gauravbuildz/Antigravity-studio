datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  projects     Project[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  prompt      String
  pages       String   // JSON string of pages: [{ name: 'Home', path: 'index.html', html: '...' }]
  chatHistory String   // Stored as serialized JSON string
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}
